              { "key": "X-Nova-Request-Id", "value": "{{nova_request_id}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{model}}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Reply with ok only\"\n    }\n  ],\n  \"max_tokens\": 8,\n  \"stream\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{nova_base_url}}/v1/chat/completions",
            "description": "Calls the selected model and produces a Nova usage event after settlement."
          }
