              "options": { "raw": { "language": "json" } }
            },
            "url": "{{nova_base_url}}/v1/images/generations",
            "description": "通过 Nova 归属和 HMAC 签名调用 OpenAI 兼容图片生成接口；请填写已配置的图片模型名称。"
          }
