{
  "info": {
    "_postman_id": "8e5666d6-1b02-4c87-bc41-e2680fd25cf2",
    "name": "Nova 集成实验室",
    "description": "All Nova HTTP calls exposed by the Nova integration lab. Import the matching environment, fill nova_hmac_secret, and select it before sending requests. Nova requests are signed automatically with HMAC-SHA256. The Create tenant and Rotate tenant key requests save returned token_key/token_name values into the active environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Nova 管理接口",
      "description": "Management calls under /api/novapay. Every request inherits the folder-level Nova HMAC pre-request script.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const textEncoder = new TextEncoder();",
              "",
              "function bytesToHex(bytes) {",
              "  return Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('');",
              "}",
              "",
              "function formEncode(value) {",
              "  return encodeURIComponent(value)",
              "    .replace(/%20/g, '+')",
              "    .replace(/[!'()*]/g, (character) =>", 
              "      '%' + character.charCodeAt(0).toString(16).toUpperCase()",
              "    );",
              "}",
              "",
              "function canonicalQuery() {",
              "  const entries = pm.request.url.query.all()",
              "    .filter((parameter) => !parameter.disabled)",
              "    .map((parameter) => [",
              "      pm.variables.replaceIn(parameter.key || ''),",
              "      pm.variables.replaceIn(parameter.value || '')",
              "    ]);",
              "  entries.sort((left, right) => {",
              "    if (left[0] !== right[0]) return left[0] < right[0] ? -1 : 1;",
              "    if (left[1] === right[1]) return 0;",
              "    return left[1] < right[1] ? -1 : 1;",
              "  });",
              "  return entries.map(([key, value]) =>",
              "    formEncode(key) + '=' + formEncode(value)",
              "  ).join('&');",
              "}",
              "",
              "function requestPath() {",
              "  const resolvedUrl = pm.variables.replaceIn(pm.request.url.toString());",
              "  const match = resolvedUrl.match(/^[a-z][a-z0-9+.-]*:\\/\\/[^/]*(\\/[^?#]*)?/i);",
              "  return match && match[1] ? match[1] : '/';",
              "}",
              "",
              "function decodeBase64Url(value) {",
              "  let normalized = value.trim().replace(/-/g, '+').replace(/_/g, '/');",
              "  normalized += '='.repeat((4 - normalized.length % 4) % 4);",
              "  return Uint8Array.from(atob(normalized), (character) => character.charCodeAt(0));",
              "}",
              "",
              "const secretValue = pm.environment.get('nova_hmac_secret') || '';",
              "const secret = decodeBase64Url(secretValue);",
              "if (secret.byteLength < 32) {",
              "  throw new Error('nova_hmac_secret must be base64url and decode to at least 32 bytes');",
              "}",
              "",
              "const timestamp = Math.floor(Date.now() / 1000).toString();",
              "const nonce = pm.variables.replaceIn('{{$guid}}');",
              "const requestId = 'nova-postman-' + pm.variables.replaceIn('{{$guid}}');",
              "pm.variables.set('request_id', requestId);",
              "pm.variables.set('order_no', requestId);",
              "pm.variables.set('nova_request_id', requestId);",
              "",
              "const body = pm.request.body && pm.request.body.mode === 'raw'",
              "  ? pm.variables.replaceIn(pm.request.body.raw || '')",
              "  : '';",
              "const bodyHash = bytesToHex(new Uint8Array(await crypto.subtle.digest('SHA-256', textEncoder.encode(body))));",
              "const canonical = [",
              "  pm.request.method.toUpperCase(),",
              "  requestPath(),",
              "  canonicalQuery(),",
              "  timestamp,",
              "  nonce,",
              "  bodyHash",
              "].join('\\n');",
              "const key = await crypto.subtle.importKey('raw', secret, { name: 'HMAC', hash: 'SHA-256' }, false, ['sign']);",
              "const signature = bytesToHex(new Uint8Array(await crypto.subtle.sign('HMAC', key, textEncoder.encode(canonical))));",
              "",
              "const keyId = (pm.environment.get('nova_key_id') || '').trim();",
              "if (keyId) {",
              "  pm.request.headers.upsert({ key: 'X-Nova-Key-Id', value: keyId });",
              "} else {",
              "  pm.request.headers.remove('X-Nova-Key-Id');",
              "}",
              "pm.request.headers.upsert({ key: 'X-Nova-Timestamp', value: timestamp });",
              "pm.request.headers.upsert({ key: 'X-Nova-Nonce', value: nonce });",
              "pm.request.headers.upsert({ key: 'X-Nova-Signature', value: signature });",
              "console.log('Nova canonical request:\\n' + canonical);"
            ]
          }
        }
      ],
